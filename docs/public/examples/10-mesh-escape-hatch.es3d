    <group id="cluster">
      <use ref="crystal" material="amethyst"/>
      <use ref="crystal" position="0.25,0,0.1" rotation="0,30,-18" scale="0.7" material="amethyst"/>
      <use ref="crystal" position="-0.22,0,0.12" rotation="0,0,22" scale="0.6" material="quartz"/>
      <use ref="crystal" position="0.05,0,-0.25" rotation="-20,10,0" scale="0.5" material="amethyst"/>
    </group>
  </defs>

  <plane size="12" material="sand"/>
  <use ref="rock" position="0,0.45,0" scale="1.4" material="stone"/>
  <use ref="cluster" position="0.2,0.75,0.3" scale="0.9"/>
  <use ref="cluster" position="-2.2,0,1.2" rotation="0,60,0" scale="0.7"/>
  <use ref="cluster" position="2.1,0,-0.6" rotation="0,140,0" scale="0.8"/>
  <use ref="ico" position="-1.6,0.4,-1.6" scale="0.4" material="quartz"/>
  <use ref="rock" position="2.4,0.25,1.6" rotation="0,90,0" scale="0.6" material="stone"/>
  <use ref="rock" position="-2.6,0.2,-0.4" rotation="0,200,10" scale="0.5" material="stone"/>
</es3d>
