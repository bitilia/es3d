<?xml version="1.0" encoding="UTF-8"?>
<!--
  The escape hatch: geometry that is data, not a formula, is stored as an
  explicit indexed triangle mesh. Meshes are still definitions, so reusing
  one costs a <use> element, but the vertex data itself is no smaller than in
  a conventional format (see docs/REPORT.md). Normals are optional: they are
  derived with a crease angle (smooth="..."; 0 = faceted).
-->
<es3d version="1">
  <title>Mesh escape hatch</title>
  <environment background="#15181e" sky="#dfe8f5" ground="#3a332b" intensity="0.6"/>
  <camera position="4.2,3.2,5.6" target="0,0.5,0" fov="40"/>
  <light type="directional" direction="-0.5,-1,-0.7" intensity="1.2"/>
  <light type="point" position="1,1.6,2" color="#b388ff" intensity="6"/>

  <defs>
    <material id="amethyst" color="#9c6ade" roughness="0.15" metallic="0.1"/>
    <material id="quartz" color="#e1f5fe" roughness="0.08" opacity="0.75"/>
    <material id="stone" color="#8a8580" roughness="0.95"/>
    <material id="sand" color="#c2b280" roughness="1"/>

    <!-- hexagonal bipyramid crystal: 8 vertices, 12 faces, flat shaded -->
    <mesh id="crystal" smooth="0"
      positions="0.3 0 0 0.15 0 -0.26 -0.15 0 -0.26 -0.3 0 0 -0.15 0 0.26 0.15 0 0.26 0 1.2 0 0 -0.25 0"
      indices="0 1 6 1 2 6 2 3 6 3 4 6 4 5 6 5 0 6 1 0 7 2 1 7 3 2 7 4 3 7 5 4 7 0 5 7"/>

    <!-- regular icosahedron, smooth shaded by the crease angle -->
    <mesh id="ico" smooth="40"
      positions="-0.526 0.851 0 0.526 0.851 0 -0.526 -0.851 0 0.526 -0.851 0 0 -0.526 0.851 0 0.526 0.851 0 -0.526 -0.851 0 0.526 -0.851 0.851 0 -0.526 0.851 0 0.526 -0.851 0 -0.526 -0.851 0 0.526"
      indices="0 11 5 0 5 1 0 1 7 0 7 10 0 10 11 1 5 9 5 11 4 11 10 2 10 7 6 7 1 8 3 9 4 3 4 2 3 2 6 3 6 8 3 8 9 4 9 5 2 4 11 6 2 10 8 6 7 9 8 1"/>

    <!-- a displaced icosphere: 162 vertices / 320 triangles of non-procedural data -->
