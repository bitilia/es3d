<?xml version="1.0" encoding="UTF-8"?>
<!--
  2,000 trees and 400 rocks from two definitions and three <scatter> elements.
  Placement is a deterministic, seeded pseudo-random process (mulberry32), so
  every ES3D reader produces exactly the same forest. The file would be the
  same size for 20 or 200,000 trees; the renderer draws each tree part with a
  single instanced draw call.
-->
<es3d version="1">
  <title>Forest</title>
  <environment background="#a7c3dc" sky="#d9e8f6" ground="#4b4a3a" intensity="0.55"/>
  <camera position="78,48,92" target="0,0,0" fov="40"/>
  <light type="directional" direction="-0.5,-1,-0.35" color="#fff3e0" intensity="1.15"/>

  <defs>
    <material id="bark" color="#6d4c41" roughness="0.9"/>
    <material id="pine1" color="#2e7d32" roughness="0.85"/>
    <material id="pine2" color="#43a047" roughness="0.85"/>
    <material id="pine3" color="#1b5e20" roughness="0.85"/>
    <material id="birch-bark" color="#eceff1" roughness="0.8"/>
    <material id="birch-leaf" color="#8bb855" roughness="0.75"/>
    <material id="stone" color="#8f8f8f" roughness="0.95"/>
    <material id="grass" color="#6b8e3a" roughness="1"/>

    <group id="pine">
      <cylinder radius="0.18" height="1.2" position="0,0.6,0" material="bark"/>
      <cone radius="1.3" height="2.2" position="0,2.1,0"/>
      <cone radius="1" height="1.8" position="0,3.1,0"/>
      <cone radius="0.7" height="1.4" position="0,4,0"/>
    </group>
    <group id="birch">
      <cylinder radius="0.12" height="2.4" position="0,1.2,0" material="birch-bark"/>
      <sphere radius="1.1" position="0,3,0" scale="1,1.3,1" material="birch-leaf"/>
    </group>
    <sphere id="rock" radius="0.6" segments="7" scale="1,0.6,1" material="stone"/>
  </defs>

  <plane size="150" material="grass"/>
  <scatter count="1500" radius="66" seed="11" randomScale="0.7..1.3" randomRotation="0,0..360,0" randomMaterial="pine1,pine2,pine3">
    <use ref="pine"/>
  </scatter>
  <scatter count="500" radius="66" seed="23" randomScale="0.8..1.2" randomRotation="0,0..360,0">
    <use ref="birch"/>
  </scatter>
  <scatter count="400" radius="70" seed="5" randomScale="0.4..1.6" randomRotation="0,0..360,0">
    <use ref="rock"/>
  </scatter>
</es3d>
