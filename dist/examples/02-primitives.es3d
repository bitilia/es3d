<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every geometry type of ES3D v1 in one scene. Nothing here stores triangles:
  each object is a handful of parameters that the renderer tessellates on demand
  (and at several levels of detail).
-->
<es3d version="1">
  <title>Primitive test scene</title>
  <environment background="#161a21" sky="#dfe9f7" ground="#3a3530" intensity="0.6"/>
  <camera position="0,8.5,13.5" target="0,0.4,0" fov="42" aspect="1.6"/>
  <light type="directional" direction="-0.45,-1,-0.6" intensity="1.25"/>
  <light type="directional" direction="0.7,-0.3,0.6" color="#9ec9ff" intensity="0.35"/>

  <defs>
    <material id="floor" color="#ffffff" roughness="0.85" map="grid(8,0.04,#465062,#2b313b)" uvScale="2,2"/>
    <material id="red" color="#ef5350" roughness="0.35"/>
    <material id="orange" color="#ffa726" roughness="0.4"/>
    <material id="yellow" color="#fdd835" roughness="0.45"/>
    <material id="green" color="#66bb6a" roughness="0.5"/>
    <material id="teal" color="#26a69a" roughness="0.3"/>
    <material id="blue" color="#42a5f5" roughness="0.25"/>
    <material id="indigo" color="#5c6bc0" roughness="0.4"/>
    <material id="purple" color="#ab47bc" roughness="0.35"/>
    <material id="pink" color="#ec407a" roughness="0.4"/>
    <material id="steel" color="#b0bec5" metallic="1" roughness="0.28"/>
    <material id="brass" color="#d4a537" metallic="1" roughness="0.3"/>
    <material id="white" color="#eceff1" roughness="0.5"/>
    <path id="star" d="M0,0.8 L-0.206,0.283 L-0.761,0.247 L-0.333,-0.108 L-0.47,-0.647 L0,-0.35 L0.47,-0.647 L0.333,-0.108 L0.761,0.247 L0.206,0.283 Z"/>
  </defs>

  <plane size="16,11" position="0,-0.5,0" material="floor"/>

  <!-- back row: analytic solids -->
  <group position="0,0,-3">
    <box size="1.1" radius="0.12" position="-6,0.05,0" material="red"/>
    <sphere radius="0.6" position="-3,0.1,0" material="orange"/>
    <cylinder radius="0.5" height="1.2" position="0,0.1,0" material="yellow"/>
    <cone radius="0.6" height="1.2" position="3,0.1,0" material="green"/>
    <capsule radius="0.35" height="1.3" position="6,0.15,0" material="teal"/>
  </group>

  <!-- middle row: tori, flat shapes, curves -->
  <group position="0,0,0">
    <torus radius="0.45" tube="0.16" position="-6,0.1,0" rotation="70,0,0" material="blue"/>
    <torus radius="0.45" tube="0.12" arc="270" position="-3,0.1,0" rotation="90,0,0" material="indigo"/>
    <polygon points="0,0.8 -0.206,0.283 -0.761,0.247 -0.333,-0.108 -0.47,-0.647 0,-0.35 0.47,-0.647 0.333,-0.108 0.761,0.247 0.206,0.283" position="0,0.3,0" material="purple"/>
    <path d="M0,-0.6 C-0.9,0 -0.6,0.75 0,0.35 C0.6,0.75 0.9,0 0,-0.6 Z" position="3,0.25,0" material="pink"/>
    <polyline points="0,0.43,0 0.214,0.47,-0.12 0.379,0.577,-0.17 0.46,0.72,-0.12 0.442,0.855,0 0.334,0.938,0.12 0.17,0.94,0.17 -0.006,0.85,0.12 -0.147,0.685,0 -0.22,0.48,-0.12 -0.209,0.283,-0.17 -0.126,0.141,-0.12 0,0.09,0 0.126,0.141,0.12 0.209,0.283,0.17 0.22,0.48,0.12 0.147,0.685,0 0.006,0.85,-0.12 -0.17,0.94,-0.17 -0.334,0.938,-0.12 -0.442,0.855,0 -0.46,0.72,0.12 -0.379,0.577,0.17 -0.214,0.47,0.12 0,0.43,0" smooth="true" radius="0.05" position="6,-0.2,0" material="steel"/>
  </group>

  <!-- front row: path operators and parametric parts -->
  <group position="0,0,3">
    <extrude path="star" depth="0.3" bevel="0.05" center="true" position="-6,0.3,0" material="orange"/>
    <revolve d="M0,0 L0.42,0 C0.72,0.25 0.72,0.7 0.4,1 C0.28,1.12 0.3,1.32 0.43,1.45" position="-3,-0.5,0" material="teal"/>
    <sweep radius="0.06" along="helix(0.42,0.22,5)" position="0,-0.45,0" material="brass"/>
    <gear teeth="18" module="0.06" depth="0.22" bore="0.14" bevel="0.015" position="3,0.25,0" rotation="-20,0,0" material="steel"/>
    <sweep d="M-0.12,-0.12 L0.12,-0.12 L0.12,0.12 L-0.12,0.12 Z" along="M-0.6,-0.4,0 C-0.6,0.6,0 0.6,0.6,0 0.6,-0.4,0" twist="180" position="6,0,0" material="red"/>
  </group>

  <!-- hairlines: the coordinate axes -->
  <line from="-7.5,-0.49,4.8" to="-6.5,-0.49,4.8" color="#ff5252"/>
  <line from="-7.5,-0.49,4.8" to="-7.5,0.51,4.8" color="#69f0ae"/>
  <line from="-7.5,-0.49,4.8" to="-7.5,-0.49,3.8" color="#448aff"/>
</es3d>
