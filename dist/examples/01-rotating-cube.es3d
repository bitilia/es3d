<?xml version="1.0" encoding="UTF-8"?>
<!-- The smallest interesting ES3D document: one rounded box and one animation. -->
<es3d version="1">
  <title>Rotating cube</title>
  <environment background="#14171d" sky="#cfe0ff" ground="#2b2622" intensity="0.55"/>
  <camera position="3.2,2.4,4.2" target="0,0,0" fov="40"/>
  <light type="directional" direction="-0.6,-1,-0.8" intensity="1.3"/>
  <light type="point" position="-2,1.5,2" color="#4fc3f7" intensity="4"/>

  <material id="orange" color="#ff7043" roughness="0.35"/>
  <material id="floor" color="#2a2f38" roughness="0.9"/>

  <box size="1.4" radius="0.14" material="orange">
    <animate attr="rotation" from="0,0,0" to="360,360,0" dur="8s"/>
  </box>
  <plane size="8" position="0,-1.25,0" material="floor"/>
</es3d>
